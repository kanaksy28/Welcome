import tensorflow as tf
from tensorflow import keras
from tensorflow.keras.layers import Embedding, LSTM, Dense
from tensorflow.keras.models import Sequential
from tensorflow.keras.datasets import imdb
from tensorflow.keras.preprocessing.sequence import pad_sequences

(trainX, trainy),(testX, testy) = imdb.load_data(num_words=10000)

trainX = pad_sequences(trainX, maxlen=200)
testX = pad_sequences(testX, maxlen=200)

model = Sequential([
    Embedding(input_dim=10000, output_dim=64),
    LSTM(64),
    Dense(1, activation='sigmoid')
])

history = model.fit(trainX, trainy, epochs=5, batch_size=64)

model.compile(optimizer='adam',
              loss='binary_crossentropy',
              metrics=['accuracy'])

loss, accuracy = model.evaluate(testX, testy)
print('Test Loss:',loss)
print('Test Accuracy:',accuracy)


# Predict sentiment of a new review
word_index = imdb.get_word_index()

review = "This movie was excellent and very enjoyable"

# Convert words into numbers
review_words = review.lower().split()
sequence = [word_index.get(word, 2) + 3 for word in review_words]

# Keep only the top 10000 words
sequence = [word if word < 10000 else 2 for word in sequence]

# Pad the sequence
sequence = pad_sequences([sequence], maxlen=200)

# Predict sentiment
prediction = model.predict(sequence)

if prediction[0][0] >= 0.5:
    print("Positive Review")
else:
    print("Negative Review")

print("Sentiment Score:", prediction[0][0])
